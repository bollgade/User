{
	"Create unit:test": {
		"prefix": "unit",
		"body": [
			"import { ${TM_FILENAME_BASE/(.test)//g} } from './${TM_FILENAME_BASE/(.test)//g}';\r",
			"\r",
			"describe('${TM_FILENAME_BASE/(.test)//g}', () => {",
			"\ttest('$1', () => {",
			"\t\texpect(${2:${TM_FILENAME_BASE/(.test)//g}($3)}).${4|toEqual,toBe|}($5)",
			"\t})",
			"})"
		],
		"description": "Create template test"
	},
	"Create redux toolkit slice": {
		"prefix": "slice",
		"body": [
			"import { createSlice } from '@reduxjs/toolkit';",
			"import { ${TM_FILENAME_BASE/(.*)(Slice)/${1:/capitalize}/}Schema } from '../types/${TM_FILENAME_BASE/(.*)(Slice)/${1}/}Schema';",
			"",
			"const initialState: ${TM_FILENAME_BASE/(.*)(Slice)/${1:/capitalize}/}Schema = {};",
			"",
			"export const ${TM_FILENAME_BASE} = createSlice({",
			"\tname: '${TM_FILENAME_BASE/(.*)(Slice)/$1/}',",
			"\tinitialState,",
			"\treducers: {},",
			"\textraReducers: (builder) => {builder},",
			"})",
			"",
			"export const { ",
			"\tactions: ${TM_FILENAME_BASE/(.*)(Slice)/$1/}Actions, ",
			"\treducer: ${TM_FILENAME_BASE/(.*)(Slice)/$1/}Reducer ",
			"} = ${TM_FILENAME_BASE};",
			""
		],
		"description": "Create redux toolkit slice"
	},
	"Create redux toolkit extraReducers": {
		"prefix": "extraReducer",
		"body": [
			"\t.addCase(${1}.pending, (state) => {",
			"\t\tstate.error = undefined;",
			"\t\tstate.isLoading = true;",
			"\t})",
			"\t.addCase(${1}.fulfilled, (state, action: PayloadAction$2<$3>) => {",
			"\t\tstate.${4:data} = action.payload;",
			"\t\tstate.isLoading = false;",
			"\t\tstate.error = undefined;",
			"\t})",
			"\t.addCase(${1}.rejected, (state, action) => {",
			"\t\tstate.isLoading = false;",
			"\t\tstate.error = action.payload;",
			"\t});"
		],
		"description": "Create redux toolkit slice"
	},
	"Create redux toolkit asyncThunk": {
		"prefix": "asyncThunk",
		"body": [
			"import { createAsyncThunk } from '@reduxjs/toolkit';",
			"import { ThunkConfig } from 'app/providers/StoreProvider';",
			"import { User, userActions } from 'entities/User';",
			"import { USER_LOCAL_STORAGE_KEY } from 'shared/const/localStorage';",
			"",
			"interface LoginByUsername Props {",
			"\tusername: string,",
			"\tpassword: string,",
			"}",
			"",
			"export const loginByUsername = createAsyncThunk<",
			"\tUser,",
			"\tLoginByUsernameProps,",
			"\tThunkConfig<string>",
			">(",
			"\t'login/loginByUsername',",
			"\tasync (authData, thunkAPI) => {",
			"\t\tconst {",
			"\t\t\tdispatch,",
			"\t\t\trejectWithValue,",
			"\t\t\textra,",
			"\t\t} = thunkAPI;",
			"",
			"\t\ttry {",
			"\t\t\tconst response = await extra.api.post('/login', authData);",
			"\t\t\tif (!response.data) {",
			"\t\t\t\tthrow new Error();",
			"\t\t\t}",
			"",
			"\t\t\tlocalStorage.setItem(USER_LOCAL_STORAGE_KEY, JSON.stringify(response.data)); // imitation of saving token",
			"\t\t\tdispatch(userActions.setAuthData(response.data));",
			"",
			"\t\t\treturn response.data;",
			"\t\t} catch (error) {",
			"\t\t\tconsole.error(error); // eslint-disable-line no-console",
			"\t\t\treturn rejectWithValue('error');",
			"\t\t}",
			"\t},",
			");",
		],
		"description": "Create asyncThunk"
	}
}