	//==========================================================================================================================================
	//
	//*Name
	//
	//==========================================================================================================================================
	//
	// $tablet: em(991.98); // Планшеты, некоторые телефоны в горизонтальном положении
	// $mobile: em(767.98); // Телефоны L
	// $mobileSmall: em(479.98); // Телефоны S
	//*Media_queary
	"Media (for md)": {
		"scope": "css, scss, sass",
		"prefix": "@md",
		"body": [
			"@media (max-width: em($$md${1:1})){",
			"\t$2",
			"}",
		],
		"description": "Media (for md)"
	},
	"Media (containerWidth)": {
		"scope": "css, scss, sass",
		"prefix": "@pc",
		"body": [
			"@media (max-width: $$pc){",
			"\t$1",
			"}",
		],
		"description": "Media (mw:em($containerWidth))"
	},
	"Media (mw:991.98)": {
		"scope": "css, scss, sass",
		"prefix": "@tablet",
		"body": [
			"@media (max-width: $$tablet){",
			"\t$1",
			"}",
		],
		"description": "Media (mw:991.98)"
	},
	"Media (mw:767.98)": {
		"scope": "css, scss, sass",
		"prefix": "@mobile",
		"body": [
			"@media (max-width: $$mobile){",
			"\t$1",
			"}",
		],
		"description": "Media (mw:767.98)"
	},
	"Media (mw:479.98)": {
		"scope": "css, scss, sass",
		"prefix": "@mobileSmall",
		"body": [
			"@media (max-width: $$mobileSmall){",
			"\t$1",
			"}",
		],
		"description": "Media (mw:479.98)"
	},
	//
	//==========================================================================================================================================
	//
	//*Margin
	"margin": {
		"scope": "css, scss, sass",
		"prefix": "m",
		"body": [
			"margin: $1px $2px $3px $4px;"
		],
		"description": "margin: _ _ _ _"
	},
	"margin-center": {
		"scope": "css, scss, sass",
		"prefix": "mc",
		"body": [
			"margin: 0 auto;"
		],
		"description": "margin: 0 auto"
	},
	"margin-top": {
		"scope": "css, scss, sass",
		"prefix": "mt",
		"body": [
			"margin: $1px 0px 0px 0px;"
		],
		"description": "margin-top: _ 0 0 0"
	},
	"margin-left": {
		"scope": "css, scss, sass",
		"prefix": "ml",
		"body": [
			"margin: 0px 0px 0px $1px;"
		],
		"description": "margin-left: 0 _ 0 0"
	},
	"margin-bottom": {
		"scope": "css, scss, sass",
		"prefix": "mb",
		"body": [
			"margin: 0px 0px $1px 0px;"
		],
		"description": "margin-bottom: 0 0 _ 0"
	},
	"margin-right": {
		"scope": "css, scss, sass",
		"prefix": "mr",
		"body": [
			"margin: 0px $1px 0px 0px;"
		],
		"description": "margin-right: 0 0 0 _"
	},
	//
	//==========================================================================================================================================
	//
	//*Padding
	"padding": {
		"scope": "css, scss, sass",
		"prefix": "p",
		"body": [
			"padding: $1px $2px $3px $4px;"
		],
		"description": "padding: _ _ _ _"
	},
	"padding-top": {
		"scope": "css, scss, sass",
		"prefix": "pt",
		"body": [
			"padding: $1px 0px 0px 0px;"
		],
		"description": "padding-top: _ 0 0 0"
	},
	"padding-left": {
		"scope": "css, scss, sass",
		"prefix": "pl",
		"body": [
			"padding: 0px 0px 0px $1px;"
		],
		"description": "padding-left: 0 _ 0 0"
	},
	"padding-bottom": {
		"scope": "css, scss, sass",
		"prefix": "pb",
		"body": [
			"padding: 0px 0px $1px 0px;"
		],
		"description": "padding-bottom: 0 0 _ 0"
	},
	"padding-right": {
		"scope": "css, scss, sass",
		"prefix": "pr",
		"body": [
			"padding: 0px $1px 0px 0px;"
		],
		"description": "padding-right: 0 0 0 _"
	},
	//
	//==========================================================================================================================================
	//
	//*last-child
	"last-child margin: 0": {
		"scope": "css, scss, sass",
		"prefix": "lcm0",
		"body": [
			"&:last-child {",
			"margin: 0;",
			"}"
		],
		"description": "margin 0 for last-child"
	},
	"last-child padding: 0": {
		"scope": "css, scss, sass",
		"prefix": "lcm0",
		"body": [
			"&:last-child {",
			"padding: 0;",
			"}"
		],
		"description": "padding 0 for last-child"
	},
	"last-child margin and padding: 0": {
		"scope": "css, scss, sass",
		"prefix": "lcm0",
		"body": [
			"&:last-child {",
			"margin: 0;",
			"padding: 0;",
			"}"
		],
		"description": "margin and padding 0 for last-child"
	},
	//
	//==========================================================================================================================================
	//
}